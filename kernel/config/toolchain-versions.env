# Cross-toolchain lock shared by macOS and Linux bootstrap scripts.
# Versions are selected from the working macOS toolchain and must pass full
# dual-architecture clean builds before any future version bump.
NEXS_X86_64_TARGET=x86_64-elf
NEXS_X86_64_BINUTILS_VERSION=2.46.1
NEXS_X86_64_GCC_VERSION=16.1.0
NEXS_AARCH64_TARGET=aarch64-none-elf
NEXS_AARCH64_BINUTILS_VERSION=2.29.1
NEXS_AARCH64_GCC_VERSION=7.2.0
# SHA-512 values published by the official GNU GCC/Binutils release indexes.
