From: NexsOS1 build compatibility layer
Subject: [backport] configure: keep i386-pc ELF .text at the requested base

GNU ld 2.46 accepts --image-base for ELF, but for the i386 PC image this
sets the LOAD segment base rather than the .text VMA.  The ELF header then
pushes .text from 0x9000 to 0x9054 and grub-mkimage correctly rejects the
miscompiled kernel.img.

The i386-pc kernel image contract requires .text to begin exactly at 0x9000.
Use -Ttext for that target.  Other targets retain the upstream capability
probe.
--- a/configure.ac
+++ b/configure.ac
@@ -1798,18 +1798,26 @@
 m4_ifndef([AX_CHECK_LINK_FLAG], [m4_fatal([autoconf-archive is missing. You must install it to generate the configure script.])])
 
 if test "x$TARGET_APPLE_LINKER" != x1 ; then
-AX_CHECK_LINK_FLAG([-Wl,--image-base,0x400000],
-    [TARGET_IMG_BASE_LDOPT="-Wl,--image-base"],
-    [TARGET_IMG_BASE_LDOPT="-Wl,-Ttext"],
-    [],
-    [AC_LANG_SOURCE([
+if test "x$target_cpu" = xi386 && test "x$platform" = xpc ; then
+  dnl GNU ld 2.46 accepts --image-base for ELF but applies it to the
+  dnl load segment, placing .text after ELF headers (0x9054 for a
+  dnl requested 0x9000 base).  PC BIOS kernel.img requires .text to
+  dnl begin exactly at the GRUB link address, so use -Ttext explicitly.
+  TARGET_IMG_BASE_LDOPT="-Wl,-Ttext"
+else
+  AX_CHECK_LINK_FLAG([-Wl,--image-base,0x400000],
+      [TARGET_IMG_BASE_LDOPT="-Wl,--image-base"],
+      [TARGET_IMG_BASE_LDOPT="-Wl,-Ttext"],
+      [],
+      [AC_LANG_SOURCE([
 asm (".globl start; start:");
 asm (".globl _start; _start:");
 asm (".globl __start; __start:");
 void __main (void);
 void __main (void) {}
 int main (void);
-    ])])
+      ])])
+fi
 grub_PROG_OBJCOPY_ABSOLUTE
 fi
 grub_PROG_LD_BUILD_ID_NONE
